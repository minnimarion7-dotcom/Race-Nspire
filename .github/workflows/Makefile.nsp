CC = nspire-gcc
CXX = nspire-g++
LD = nspire-ld
GENZEHN = genzehn

CFLAGS = -O3 -Wall -D__NSPIRE__ -I. -Iemu -Iopendingux
CXXFLAGS = $(CFLAGS) -fno-exceptions -fno-rtti
LDFLAGS = -lSDL -lm -lz

# Automatically grab all .cpp and .c files in emu and opendingux
CPP_SRCS = $(wildcard emu/*.cpp opendingux/*.cpp)
C_SRCS = $(wildcard emu/*.c opendingux/*.c)
OBJS = $(CPP_SRCS:.cpp=.o) $(C_SRCS:.c=.o)

all: race.tns

race.elf: $(OBJS)
	$(CXX) $(OBJS) -o $@ $(LDFLAGS)

race.tns: race.elf
	$(GENZEHN) --input $^ --output $@.zehn --name "RACE"
	make-prg $@.zehn $@
	rm -f $@.zehn

clean:
	rm -f $(OBJS) race.elf race.tns

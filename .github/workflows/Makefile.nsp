CC = nspire-gcc
CXX = nspire-g++
LD = nspire-ld
GENZEHN = genzehn

CFLAGS = -O3 -Wall -D__NSPIRE__ -I. -Isrc -Isrc/cz80 -Isrc/drz80
CXXFLAGS = $(CFLAGS) -fno-exceptions -fno-rtti
LDFLAGS = -lSDL -lm -lz

OBJS = src/main.o src/neopop.o src/mem.o src/gfx.o src/sound.o src/input.o src/rom.o src/state.o src/tlcs900h.o src/z80.o

all: race.tns

race.elf: $(OBJS)
	$(CXX) $(OBJS) -o $@ $(LDFLAGS)

race.tns: race.elf
	$(GENZEHN) --input $^ --output $@.zehn --name "RACE"
	make-prg $@.zehn $@
	rm -f $@.zehn

clean:
	rm -f $(OBJS) race.elf race.tns
